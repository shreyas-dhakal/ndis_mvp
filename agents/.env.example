DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Provider selection
CHAT_PROVIDER=azure_openai
AGENT_PROVIDER=azure_openai
EMBEDDING_PROVIDER=azure_openai
VOICE_PROVIDER=faster_whisper

# Chat and note generation
CHAT_MODEL="gpt-5.4"
CHAT_DEPLOYMENT="gpt-5.4"
AGENT_MODEL="gpt-5.4"
AGENT_DEPLOYMENT="gpt-5.4"

# Embeddings
EMBEDDING_MODEL="text-embedding-3-large"
EMBEDDING_DEPLOYMENT="text-embedding-3-large"
EMBEDDING_DIM=3072

# Voice / transcription
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_DEPLOYMENT=small
VOICE_TRANSCRIPTION_LANGUAGE=en-AU

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Optional TTS config for future voice output wiring
TTS_PROVIDER=piper
TTS_MODEL=en_US-lessac-medium
TTS_DEPLOYMENT=en_US-lessac-medium
TTS_VOICE=en_US-lessac-medium

# Optional OpenAI-compatible model registry exposed at /v1/models
# INFERENCE_MODEL_REGISTRY_JSON={"gpt-5.4":{"provider":"azure_openai","model":"gpt-5.4","deployment":"gpt-5.4"}}

# Optional Ollama/local fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_AGENT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

EMBED_BATCH_SIZE=32
EMBED_CONCURRENCY=4

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8

RETRIEVAL_SEMANTIC_CANDIDATES=60
RETRIEVAL_LEXICAL_CANDIDATES=60
RETRIEVAL_TRIGRAM_CANDIDATES=40
RETRIEVAL_RRF_K=50
RETRIEVAL_GROUP_LIMIT=12
RETRIEVAL_ADJACENT_WINDOW=1

AGE_ENABLED=false
AGE_GRAPH_NAME=ndis_context
