POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_CONCURRENCY=6
OLLAMA_EMBED_BATCH_SIZE=64
EMBEDDING_DIM=768

# Postgres pool
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Retrieval tuning
RETRIEVAL_SEMANTIC_CANDIDATES=80
RETRIEVAL_LEXICAL_CANDIDATES=80
RETRIEVAL_RRF_K=50

# LangSmith (optional)
LANGSMITH_API_KEY=
# Optional: override the LangSmith project name
LANGSMITH_PROJECT=ndis-rag

# Text embedding settings
# The embedding dimension must match the configured embedding model.
# Example: nomic-embed-text -> 768.

# Service
PORT=8000
LOG_LEVEL=info

# Upload/ingestion
DATA_DIR=./data
